<script
  id="<%= script_id %>"
  src="<%= src %>"
  type="<%= script_type %>"
  <% if async? %>async<% end %>
  <% if crossorigin %>crossorigin="<%= crossorigin %>"<% end %>
  <% if integrity %>integrity="<%= integrity %>"<% end %>
  <% if nonce %>nonce="<%= nonce %>"<% end %>
  <% if referrerpolicy %>referrerpolicy="<%= referrerpolicy %>"<% end %>
></script>
